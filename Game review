<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8">
    <style>
        .content {
    flex: 1;
    padding: 30px; /* Ruang tepi yang lebih luas */
    background-color: #14171e;
    transition: margin-left 0.3s ease;
}

/* Grid yang lebar dan responsif */
.game-grid {
    display: grid;
    /* Lebar kad minimum 280px supaya nampak besar seperti IGN */
    grid-template-columns: repeat(auto-fill, minmax(150px,1fr)); 
    gap: 25px; 
    margin-top: 20px;
    max-width: 10px; /* Tukar angka ini mengikut kelebaran yang anda mahu */
    width: 100%;
    height: auto; 
}

/* Gaya Kad Permainan yang lebih lebar */
.game-card {
    max-width: 600px;
    background-color: #1e2330;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #333;
    transition: 0.3s;
    width: 100%;
}

.game-card:hover {
    transform: scale(1.02); /* Efek membesar sikit bila hover */
    filter: contrast(1.1) brightness(1.1);
}

/* Poster dengan nisbah lebar yang cantik */
.game-poster {
    position: relative;
    width: 100%;
    height: auto; 
    line-height: 0;
    display: block;
    /* Ini adalah kunci untuk mengurangkan blur pada imej */
    image-rendering: -webkit-optimize-contrast; 
    image-rendering: crisp-edges;               
    object-fit: cover;
}

.game-poster img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    filter: contrast(1.05) brightness(1.02);
    transition: filter 0.3s ease;
}

/* Skor Merah IGN */
.game-rating {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background-color: #bf0000;
    color: white;
    padding: 8px 10px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
}  
    </style>
    <body>
        <main class="content">
   <div class="game-card">
            <div class="game-poster">
                <img src="i.webp" alt="Game 2">
                <span class="game-rating">9.2</span>
            </div>
            <div class="game-info">
                <h3>Elden Ring: Shadow of the Erdtree</h3>
                <p>Open World • Soulslike</p>
            </div>
        </div>
</main>
    </body>